{
  "manifest_version": 3,
  "name": "Chess AI Master",
  "version": "4.0",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dontosintme69@gmail.com",
      "strict_min_version": "109.0"
    }
  },
  "description": "The most advanced chess analysis engine - IQ: 9,000,000",
  "author": "MR-golem",
  "permissions": [
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "js": ["scripts/main.js"],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.png",
    "default_title": "Chess AI Master"
  },
  "web_accessible_resources": [
    {
      "resources": ["scripts/page.js", "icons/icon.png"],
      "matches": ["https://www.chess.com/*", "https://chess.com/*"]
    }
  ]
}
